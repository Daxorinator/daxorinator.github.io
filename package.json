{
	"name": "override.online",
	"version": "1.1.0",
	"description": "CrashOverride's Blog and Website built with Eleventy and nes.css",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/override-online-build/",
		"start": "npx @11ty/eleventy --serve --quiet",
		"debug": "DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/daxorinator/daxorinator.github.io.git"
	},
	"author": {
		"name": "Seán Kelly",
		"email": "sean@override.online",
		"url": "https://override.online/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=14"
	},
	"bugs": {
		"url": "https://github.com/daxorinator/daxorinator.github.io/issues"
	},
	"homepage": "https://github.com/daxorinator/daxorinator.github.io/",
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-img": "^6.0.0",
		"@11ty/eleventy-navigation": "^1.0.0",
		"@11ty/eleventy-plugin-rss": "^2.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
		"luxon": "^3.2.1",
		"markdown-it-anchor": "^9.0.0"
	},
	"dependencies": {
	}
